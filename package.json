{
  "name": "backspin",
  "productName": "Backspin",
  "version": "0.1.0",
  "description": "A little spinning record player widget for Spotify",
  "main": "src/main/main.js",
  "author": "Jason",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/make-icons.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.jason.backspin",
    "productName": "Backspin",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.music",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
